{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DDL Calendar",
  "version": "0.1.0",
  "identifier": "cn.ddlcalendar.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "DDL Calendar",
        "width": 1440,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "A visual deadline calendar",
    "longDescription": "A local-first Windows calendar for tracking course deadlines.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
